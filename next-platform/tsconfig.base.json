{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": false,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@consubov/contracts": ["./packages/contracts/src/index.ts"],
      "@consubov/contracts/*": ["./packages/contracts/src/*"],
      "@consubov/domain-projection": ["./packages/domain-projection/src/index.ts"],
      "@consubov/domain-projection/*": ["./packages/domain-projection/src/*"],
      "@consubov/ui": ["./packages/ui/src/index.ts"],
      "@consubov/ui/*": ["./packages/ui/src/*"],
      "@consubov/auth-client": ["./packages/auth-client/src/index.ts"],
      "@consubov/auth-client/*": ["./packages/auth-client/src/*"],
      "@consubov/module-release": ["./packages/module-release/src/index.ts"],
      "@consubov/module-release/*": ["./packages/module-release/src/*"],
      "@consubov/testing": ["./packages/testing/src/index.ts"],
      "@consubov/testing/*": ["./packages/testing/src/*"],
      "@consubov/platform-api": ["./api/src/index.ts"],
      "@consubov/platform-api/*": ["./api/src/*"],
      "@consubov/fazenda-gerente": ["./apps/fazenda/gerente/src/index.ts"],
      "@consubov/fazenda-gerente/*": ["./apps/fazenda/gerente/src/*"],
      "@consubov/fazenda-capataz": ["./apps/fazenda/capataz/src/index.ts"],
      "@consubov/fazenda-capataz/*": ["./apps/fazenda/capataz/src/*"],
      "@consubov/fazenda-escritorio": ["./apps/fazenda/escritorio/src/index.ts"],
      "@consubov/fazenda-escritorio/*": ["./apps/fazenda/escritorio/src/*"],
      "@consubov/fazenda-fabrica": ["./apps/fazenda/fabrica/src/index.ts"],
      "@consubov/fazenda-fabrica/*": ["./apps/fazenda/fabrica/src/*"],
      "@consubov/fazenda-shell": ["./apps/fazenda/shell/src/index.ts"],
      "@consubov/fazenda-shell/*": ["./apps/fazenda/shell/src/*"]
    }
  }
}
