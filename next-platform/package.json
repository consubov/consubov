{
  "name": "@consubov/next-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/admin-global",
    "apps/fazenda/*",
    "packages/*",
    "api",
    "qa"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "bun run --filter '*' lint",
    "test": "bun test qa/suites/",
    "check": "bun run typecheck && bun run test",
    "qa:q1": "bun run qa/scripts/run-q1-gate.ts",
    "qa:q2": "bun run qa/scripts/run-q2-gate.ts",
    "qa:q3": "bun run qa/scripts/run-q3-gate.ts",
    "qa:q4": "bun run qa/scripts/run-q4-gate.ts",
    "qa:q5": "bun run qa/scripts/run-q5-gate.ts",
    "qa:q6": "bun run qa/scripts/run-q6-gate.ts",
    "qa:q7": "bun run qa/scripts/run-q7-gate.ts",
    "qa:q8": "bun run qa/scripts/run-q8-gate.ts",
    "dev:api": "bun run --cwd api dev",
    "dev:shell": "bun run --cwd apps/fazenda/shell dev",
    "dev:admin": "bun run --cwd apps/admin-global dev",
    "build:modules": "bun run apps/fazenda/shell/scripts/build-module-artifacts.ts",
    "serve:modules": "bun run qa/scripts/serve-module-artifacts.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "typescript": "^5.8.3"
  }
}
