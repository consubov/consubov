          "access_token",
          "refresh_token",
          "token_type",
          "expires_in"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "available_memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          },
          "requires_context_selection": {
            "type": "boolean"
          },
          "tokens": {
            "$ref": "#/components/schemas/TokenPair"
          },
          "initial_data": {
            "$ref": "#/components/schemas/ModuleProvisioning"
          }
        },
        "required": [
          "session",
          "available_memberships",
          "requires_context_selection"
        ]
      },
      "ModuleProvisioning": {
        "description": "Current authorized account projection on successful selected-context login; version is server module revision. Download and verify referenced attachment bytes before durable device provisioning. Repeated login must preserve existing pending local work.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion",
          "context",
          "snapshot"
        ],
        "properties": {
          "protocolVersion": {
            "const": 1
          },
          "context": {
            "$ref": "module-protocol.schema.json#/$defs/ExecutionContext"
          },
          "snapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "aggregateType",
              "aggregateId",
              "version",
              "data",
              "modifiedAt"
            ],
            "properties": {
              "aggregateType": {
                "const": "module-state"
              },
              "aggregateId": {
                "const": "bootstrap"
              },
              "version": {
                "type": "integer",
                "minimum": 0
              },
              "data": {
                "type": "object"
              },
              "modifiedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "attachment_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttachmentRef"
            }
          }
        }
      },
      "LedgerAck": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "const": "COMMITTED"
          },
          "aggregate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "aggregate_version": {
            "type": "integer",
            "minimum": 0
          },
          "committed_at": {
            "type": "string",
            "format": "date-time"
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "idempotent_replay": {
            "type": "boolean"
          }
        },
        "required": [
          "command_id",
          "status",
          "aggregate_id",
          "aggregate_version",
          "committed_at",
          "correlation_id"
        ]
      },
      "StoredCommand": {
        "type": "object",
        "properties": {
          "envelope": {
            "$ref": "#/components/schemas/AtomicCommand"
          },
          "ack": {
            "$ref": "#/components/schemas/LedgerAck"
          },
          "stored_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "envelope",
          "ack",
          "stored_at"
        ]
      },
      "CommandConflict": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "const": "CONFLICT_409"
          },
          "command_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "aggregate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "base_version": {
            "type": "integer",
            "minimum": 0
          },
          "current_version": {
            "type": "integer",
            "minimum": 0
          },
          "conflict_reason": {
            "type": "string"
          },
          "resolution_strategy": {
            "enum": [
              "MANUAL_RESOLUTION_REQUIRED",
              "RETRY_WITH_NEW_BASE_VERSION"
            ]
          },
          "details": {
            "type": "object"
          }
        },
        "required": [
          "error",
          "command_id",
          "aggregate_id",
          "base_version",
          "current_version",
          "conflict_reason",
          "resolution_strategy"
        ]
      },
      "CommandValidation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "const": "UNPROCESSABLE_ENTITY_422"
          },
          "command_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "message": {
                  "type": "string"
                },
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "field",
                "message",
                "code"
              ]
            }
          }
        },
        "required": [
          "error",
          "command_id",
          "violations"
        ]
      },
      "CommandSecurity": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "enum": [
              "UNAUTHORIZED_401",
              "FORBIDDEN_403"
            ]
          },
          "command_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reason": {
            "type": "string"
          },
          "required_capability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "error",
          "command_id",
          "reason"
        ]
      },
      "CommandApiResponse": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "success": {
                "const": true
              },
              "ack": {
                "$ref": "#/components/schemas/LedgerAck"
              }
            },
            "required": [
              "success",
              "ack"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "success": {
                "const": false
              },
              "conflict": {
                "$ref": "#/components/schemas/CommandConflict"
              }
            },
            "required": [
              "success",
              "conflict"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "success": {
                "const": false
              },
              "validation": {
                "$ref": "#/components/schemas/CommandValidation"
              }
            },
            "required": [
              "success",
              "validation"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "success": {
                "const": false
              },
              "security": {
                "$ref": "#/components/schemas/CommandSecurity"
              }
            },
            "required": [
              "success",
              "security"
            ]
          }
        ]
      },
      "AttachmentRef": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "attachment_id": {
            "type": "string",
            "format": "uuid"
          },
          "mime_type": {
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20971520
          },
          "hash_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "local_blob_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "attachment_id",
          "mime_type",
          "size_bytes",
          "hash_sha256",
          "local_blob_ref"
        ]
      },
      "SyncDelta": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "delta_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "aggregate_type": {
            "const": "module-state"
          },
          "aggregate_id": {
            "const": "bootstrap"
          },
          "operation": {
            "const": "UPSERT"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "data": {
            "type": "object"
          },
          "modified_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "delta_id",
          "aggregate_type",
          "aggregate_id",
          "operation",
          "version",
          "data",
          "modified_at"
        ]
      },
      "SyncPull": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "fazenda_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "next_cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "has_more": {
            "type": "boolean"
          },
          "deltas": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/SyncDelta"
            }
          },
          "server_timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "attachment_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttachmentRef"
            }
          }
        },
        "required": [
          "tenant_id",
          "fazenda_id",
          "next_cursor",
          "has_more",
          "deltas",
          "server_timestamp"
        ]
      }
    }
  }
}
