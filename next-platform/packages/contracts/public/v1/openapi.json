          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "consubov-mock-api"
          },
          "version": {
            "const": "0.1.0-incubated"
          },
          "environment": {
            "const": "local_isolated_lab"
          },
          "uptime_seconds": {
            "type": "number",
            "minimum": 0
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
