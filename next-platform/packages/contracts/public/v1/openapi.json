      }
    },
    "/api/v1/commands": {
      "post": {
        "operationId": "submitCommandToLocalLedger",
        "x-implementation-status": "IMPLEMENTED_IN_MEMORY",
        "security": [
          {
            "LabBearer": []
          }
        ],
        "description": "Bearer verified before parsing. Current server-issued session, active membership, full account/device/product/tenant/farm/retreat/profile scope, sync.push capability and RBAC required. Only supported domain-projection commands apply. Atomic projection/version/command/ACK/event commit; immutable identical retry returns original ACK unchanged. Changed payload, ID or key returns409 without mutation. Every referenced attachment must already be verified and persisted. Process-memory lifetime only.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AtomicCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Local response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Local response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Local response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandApiResponse"
                }
              }
            }
          },
          "405": {
            "description": "Local response",
            "content": {
              "application/json": {
