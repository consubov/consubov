    "/api/v1/sync": {
      "get": {
        "operationId": "pullAuthorizedModuleProjection",
        "x-implementation-status": "IMPLEMENTED_IN_MEMORY",
        "security": [
          {
            "LabBearer": []
          }
        ],
        "description": "GET exact route only. All scope comes from current server-issued grant. Query identity must match token. Cursor is opaque and bound to account, device, session and server lifetime; unknown/cross-context/restarted cursor returns400 INVALID_CURSOR. Request without cursor starts replay. Changes since the cursor coalesce into the latest COMPLETE module-state/bootstrap projections, not command payloads; version is monotonic server module revision, separate from local CAS. At most one latest complete delta is returned, has_more is false; old full snapshots are not replayed after newer login seeds. attachment_refs contains exact photo refs for this snapshot. Clients defer full-state application and cursor advancement while any local outbox is pending. No generic merge/LWW.",
        "parameters": [
          {
            "name": "tenant_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fazenda_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "profile_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since_cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Local response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncPull"
                }
              }
            }
          },
          "400": {
            "description": "Local response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Local response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Local response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
