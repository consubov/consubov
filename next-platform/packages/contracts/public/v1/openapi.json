            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "tenant_nome": {
            "type": "string"
          },
          "fazenda_id": {
            "type": "string"
          },
          "fazenda_nome": {
            "type": "string"
          },
          "retiro_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "retiro_nome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "profile_id": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          }
        },
        "required": [
          "membership_id",
          "tenant_id",
          "tenant_nome",
          "fazenda_id",
          "fazenda_nome",
          "retiro_id",
          "retiro_nome",
          "profile_id",
          "is_active"
        ]
      },
      "AuthorizedContext": {
        "type": "object",
        "properties": {
          "context_id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "tenant_nome": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "fazenda_id": {
            "type": "string"
          },
          "fazenda_nome": {
            "type": "string"
          },
          "retiro_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "retiro_nome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "profile_id": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "context_id",
          "tenant_id",
          "tenant_nome",
          "product_id",
          "fazenda_id",
          "fazenda_nome",
          "retiro_id",
          "retiro_nome",
          "profile_id",
          "capabilities"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "user_email": {
            "type": "string"
          },
          "profile_id": {
            "type": "string"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          },
          "active_context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AuthorizedContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "device_id": {
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "user_id",
          "user_name",
          "user_email",
          "profile_id",
          "memberships",
          "active_context",
          "issued_at",
          "expires_at",
          "device_id"
