            "description": "Filtered in-memory command records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "logs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StoredCommand"
                      }
                    }
                  },
                  "required": [
                    "total",
                    "logs"
                  ]
