  "components": {
    "securitySchemes": {
      "LabBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Synthetic JWT (lab only)"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
