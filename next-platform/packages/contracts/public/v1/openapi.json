      },
      "get": {
        "operationId": "downloadAuthorizedImage",
        "x-implementation-status": "IMPLEMENTED_IN_MEMORY",
        "security": [
          {
            "LabBearer": []
          }
        ],
        "description": "Current sync.pull grant and account ACL. Other account/module/farm/retreat cannot read;404. Returns raw verified bytes, Content-Type/Length and X-Attachment-Sha256.",
        "responses": {
          "200": {
            "description": "Verified image bytes",
            "headers": {
