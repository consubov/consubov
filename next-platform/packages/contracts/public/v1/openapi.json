      "parameters": [
        {
          "name": "attachment_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "put": {
        "operationId": "uploadVerifiedImage",
        "x-implementation-status": "IMPLEMENTED_IN_MEMORY",
        "security": [
          {
            "LabBearer": []
          }
        ],
        "description": "Raw image bytes, max20MiB. Current sync.push grant required and rechecked after streaming/hash await. Enforces exact size, SHA256, MIME allowlist and image signature. Identical ID/ref/content retry succeeds; immutable ID reuse with changed metadata returns409. Scope is authorized account/module/product/tenant/farm/retreat, shared across its devices. Does not perform complete image decoding or content scanning.",
        "parameters": [
          {
            "name": "X-Attachment-Size",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Attachment-Sha256",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Attachment-Local-Ref",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/webp": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Local response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttachmentRef"
                }
