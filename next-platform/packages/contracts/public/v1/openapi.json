{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "CONSUBOV F23 local laboratory HTTP API",
    "version": "1.0.0",
    "description": "Implemented local laboratory API: synthetic selected-context grants, transactional process-memory domain projections, stable idempotent ACK, scoped incremental full-module pull and validated image attachments. No production provider, durable server storage or remote database."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3333",
      "description": "Local synthetic laboratory only; a future remote service requires HTTPS."
    }
  ],
  "x-implementation-status": "LOCAL_LAB_ONLY",
  "x-router-behavior": {
    "options": "All paths OPTIONS 204 with wildcard CORS. Exact command/auth/sync/audit routes; attachment route has one ID segment. Wrong methods rejected; unknown suffixes return404. CORS is not an authorization boundary.",
    "security": "Bearer synthetic JWT only; no remote auth/provider. CORS is not an authorization boundary."
  },
  "x-planned-t04": {
    "status": "LOCAL_HANDLERS_IMPLEMENTED_TESTED",
    "future": "Durable central adapter, production identity provider, real remote endpoints and persistent storage remain PROPOSED and are not implemented."
  },
