    "LanguageChanged": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "shell:language-changed"
        },
        "protocolVersion": {
          "const": 1
        },
        "language": {
          "enum": [
            "pt-BR",
            "en-US"
          ]
        }
      },
      "required": [
        "kind",
        "protocolVersion",
        "language"
      ],
      "additionalProperties": false
    },
    "OperationIssueIdentifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
    "OperationIssue": {
      "type": "object", "additionalProperties": false,
      "required": ["commandId", "commandType", "aggregateType", "aggregateId", "occurredAt", "recordedAt", "kind"],
      "properties": {
        "commandId": { "$ref": "#/$defs/OperationIssueIdentifier" },
        "commandType": { "$ref": "#/$defs/OperationIssueIdentifier" },
        "aggregateType": { "$ref": "#/$defs/OperationIssueIdentifier" },
        "aggregateId": { "$ref": "#/$defs/OperationIssueIdentifier" },
        "occurredAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "recordedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "kind": { "enum": ["conflict", "validation", "security"] },
        "currentVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "baseVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "violations": {
          "type": "array", "maxItems": 100,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["field", "code", "message"],
            "properties": {
              "field": { "$ref": "#/$defs/OperationIssueIdentifier" },
              "code": { "$ref": "#/$defs/OperationIssueIdentifier" },
              "message": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }
            }
          }
        }
      }
    },
    "OperationIssues": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/OperationIssue" } },
    "DataChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocolVersion", "moduleId", "nonce"],
      "properties": {
        "kind": { "const": "shell:data-changed" },
        "protocolVersion": { "const": 1 },
        "moduleId": { "enum": ["capataz", "gerente", "escritorio", "fabrica"] },
        "nonce": { "type": "string", "format": "uuid" }
      }
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "aggregateType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "aggregateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "type": "object"
        },
        "modifiedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "aggregateType",
        "aggregateId",
        "version",
        "data",
        "modifiedAt"
      ],
      "additionalProperties": false
    },
    "AttachmentRef": {
      "type": "object",
      "properties": {
        "attachment_id": {
          "type": "string",
          "format": "uuid"
        },
        "mime_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20971520
        },
        "hash_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "local_blob_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        }
      },
      "required": [
        "attachment_id",
        "mime_type",
        "size_bytes",
