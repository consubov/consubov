        "moduleId",
        "nonce",
        "kind",
        "requestId"
      ],
      "additionalProperties": false
    },
    "ShellVerifyActivation": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "moduleId": {
          "enum": [
            "capataz",
            "gerente",
            "escritorio",
            "fabrica"
          ]
        },
        "nonce": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "shell:verify-activation"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "leaseId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "protocolVersion",
        "moduleId",
        "nonce",
        "kind",
        "requestId",
        "leaseId"
      ],
      "additionalProperties": false
    },
    "ShellReleaseActivation": {
      "type": "object",
