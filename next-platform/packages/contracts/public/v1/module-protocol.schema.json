      },
      "required": [
        "protocolVersion",
        "moduleId",
        "profileId",
        "nonce",
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "moduleId": {
                "const": "capataz"
              }
            }
          },
          "then": {
            "properties": {
              "profileId": {
                "const": "capataz"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleId": {
                "const": "gerente"
              }
            }
          },
          "then": {
            "properties": {
              "profileId": {
                "const": "gerente"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleId": {
                "const": "escritorio"
              }
            }
          },
          "then": {
            "properties": {
              "profileId": {
                "const": "escritorio"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleId": {
