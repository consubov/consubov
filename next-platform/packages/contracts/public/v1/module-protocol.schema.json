            "escritorio",
            "fabrica"
          ]
        },
        "nonce": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "shell:release-activation"
        },
        "leaseId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "protocolVersion",
        "moduleId",
        "nonce",
        "kind",
        "leaseId"
      ],
      "additionalProperties": false
    },
    "ModuleQuiescence": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "moduleId": {
          "enum": [
            "capataz",
            "gerente",
            "escritorio",
            "fabrica"
          ]
        },
        "nonce": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "module:quiescence"
        },
        "quiescent": {
          "type": "boolean"
        },
        "frozen": {
          "type": "boolean"
        },
        "counts": {
          "type": "object",
          "properties": {
            "FORM_DIRTY": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "CAMERA_ACTIVE": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "WEIGHING_ACTIVE": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "OUTBOX_SYNCING": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "QR_SCANNING": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "LOCAL_DB_TRANSACTION": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "FORM_DIRTY",
            "CAMERA_ACTIVE",
            "WEIGHING_ACTIVE",
            "OUTBOX_SYNCING",
            "QR_SCANNING",
            "LOCAL_DB_TRANSACTION"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "moduleId",
        "nonce",
        "kind",
        "quiescent",
        "frozen",
        "counts"
      ],
      "additionalProperties": false
    },
    "ModuleActivationPrepared": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "moduleId": {
          "enum": [
            "capataz",
            "gerente",
            "escritorio",
            "fabrica"
          ]
        },
        "nonce": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "module:activation-prepared"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "prepared": {
          "type": "boolean"
        },
        "leaseId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "protocolVersion",
        "moduleId",
        "nonce",
        "kind",
        "requestId",
        "prepared",
        "leaseId",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "ModuleActivationVerified": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "moduleId": {
          "enum": [
            "capataz",
            "gerente",
            "escritorio",
            "fabrica"
          ]
        },
        "nonce": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "module:activation-verified"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "leaseId": {
          "type": "string",
          "format": "uuid"
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "protocolVersion",
        "moduleId",
        "nonce",
        "kind",
        "requestId",
        "leaseId",
        "valid"
      ],
      "additionalProperties": false
    },

    "ExecutionContext": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "farmId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "retreatId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "moduleId": {
          "enum": [
            "capataz",
            "gerente",
            "escritorio",
            "fabrica"
          ]
        },
        "profileId": {
          "enum": [
            "capataz",
            "gerente",
            "escritorio",
            "fabrica"
          ]
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "productId": {
          "const": "consubov"
        }
      },
      "required": [
        "userId",
        "tenantId",
        "farmId",
        "retreatId",
        "moduleId",
        "profileId",
        "deviceId",
        "productId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "moduleId": {
                "const": "capataz"
              }
            }
          },
          "then": {
            "properties": {
              "profileId": {
                "const": "capataz"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleId": {
                "const": "gerente"
              }
            }
          },
          "then": {
            "properties": {
              "profileId": {
                "const": "gerente"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleId": {
                "const": "escritorio"
              }
            }
          },
          "then": {
            "properties": {
              "profileId": {
                "const": "escritorio"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleId": {
                "const": "fabrica"
              }
            }
          },
          "then": {
            "properties": {
              "profileId": {
                "const": "fabrica"
              }
            }
          }
        }
      ]
    },
    "ModuleHello": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "moduleId": {
          "enum": [
            "capataz",
            "gerente",
            "escritorio",
            "fabrica"
          ]
        },
        "profileId": {
          "enum": [
            "capataz",
            "gerente",
            "escritorio",
            "fabrica"
          ]
        },
        "nonce": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "module:hello"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "protocolVersion",
        "moduleId",
        "profileId",
        "nonce",
        "kind",
        "version"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "moduleId": {
                "const": "capataz"
              }
            }
          },
          "then": {
            "properties": {
              "profileId": {
                "const": "capataz"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleId": {
                "const": "gerente"
              }
            }
          },
          "then": {
            "properties": {
              "profileId": {
                "const": "gerente"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleId": {
                "const": "escritorio"
              }
            }
          },
          "then": {
            "properties": {
              "profileId": {
                "const": "escritorio"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleId": {
                "const": "fabrica"
              }
            }
          },
          "then": {
            "properties": {
              "profileId": {
                "const": "fabrica"
              }
            }
          }
        }
      ]
    },
    "ShellInit": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "moduleId": {
          "enum": [
            "capataz",
            "gerente",
            "escritorio",
            "fabrica"
          ]
        },
        "profileId": {
          "enum": [
            "capataz",
            "gerente",
            "escritorio",
            "fabrica"
          ]
        },
        "nonce": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "shell:init"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "context": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "local-data.read",
              "local-data.write",
              "sync.pull",
              "sync.push"
            ]
          },
          "uniqueItems": true,
          "maxItems": 4
        },
        "language": {
          "enum": [
            "pt-BR",
            "en-US"
          ]
        }
      },
      "required": [
        "protocolVersion",
        "moduleId",
        "profileId",
        "nonce",
        "kind",
        "version",
        "context",
        "capabilities",
        "language"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "moduleId": {
                "const": "capataz"
              }
            }
          },
          "then": {
            "properties": {
              "profileId": {
                "const": "capataz"
              },
              "context": {
                "properties": {
                  "moduleId": {
                    "const": "capataz"
                  },
                  "profileId": {
                    "const": "capataz"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleId": {
                "const": "gerente"
              }
            }
          },
          "then": {
            "properties": {
              "profileId": {
                "const": "gerente"
              },
              "context": {
                "properties": {
                  "moduleId": {
                    "const": "gerente"
                  },
                  "profileId": {
                    "const": "gerente"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleId": {
                "const": "escritorio"
              }
            }
          },
          "then": {
            "properties": {
              "profileId": {
                "const": "escritorio"
              },
              "context": {
                "properties": {
                  "moduleId": {
                    "const": "escritorio"
                  },
                  "profileId": {
                    "const": "escritorio"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleId": {
                "const": "fabrica"
              }
            }
          },
          "then": {
            "properties": {
              "profileId": {
                "const": "fabrica"
              },
              "context": {
                "properties": {
                  "moduleId": {
                    "const": "fabrica"
                  },
                  "profileId": {
                    "const": "fabrica"
                  }
                }
              }
            }
          }
        }
      ]
    },
