{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.consubov.invalid/f23/v1/module-protocol.schema.json",
  "title": "F23 shell/module protocol v1",
  "description": "JSON-compatible subset of structured-clone wire messages. Blob fields and total UTF-8 + Blob byte budget require browser runtime checks. Context is issued only by shell:init; RPC has no caller context or capability field. Scoped strings are trimmed by the runtime before length validation; producers should send trimmed identifiers.",
  "oneOf": [
    {
      "$ref": "#/$defs/ModuleHello"
    },
    {
      "$ref": "#/$defs/ShellInit"
    },
    {
      "$ref": "#/$defs/ModuleReady"
    },
    {
      "$ref": "#/$defs/LanguageChanged"
    },
    {
      "$ref": "#/$defs/DataChanged"
    },
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    },
    {"$ref": "#/$defs/ModuleHealth"},
    {"$ref": "#/$defs/ModuleRuntimeFailure"},
    {"$ref": "#/$defs/ShellPrepareActivation"},
    {"$ref": "#/$defs/ShellVerifyActivation"},
    {"$ref": "#/$defs/ShellReleaseActivation"},
    {"$ref": "#/$defs/ModuleQuiescence"},
    {"$ref": "#/$defs/ModuleActivationPrepared"},
    {"$ref": "#/$defs/ModuleActivationVerified"}
  ],
  "$defs": {
    "ModuleHealth": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "moduleId": {
          "enum": [
            "capataz",
            "gerente",
            "escritorio",
            "fabrica"
          ]
        },
        "nonce": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "module:healthy"
        },
        "profileId": {
          "enum": [
            "capataz",
            "gerente",
            "escritorio",
            "fabrica"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "protocolVersion",
        "moduleId",
        "nonce",
        "kind",
        "profileId",
        "version"
      ],
      "additionalProperties": false
    },
    "ModuleRuntimeFailure": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "moduleId": {
          "enum": [
            "capataz",
            "gerente",
            "escritorio",
            "fabrica"
          ]
        },
        "nonce": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "module:runtime-failure"
        },
        "profileId": {
          "enum": [
            "capataz",
            "gerente",
            "escritorio",
            "fabrica"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "protocolVersion",
        "moduleId",
        "nonce",
        "kind",
        "profileId",
        "version"
      ],
      "additionalProperties": false
    },
    "ShellPrepareActivation": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "moduleId": {
          "enum": [
            "capataz",
