{
  "name": "consubov",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@consubov/web",
    "dev:api": "turbo run dev --filter=@consubov/api",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@consubov/web",
    "build:api": "turbo run build --filter=@consubov/api",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "bun run typecheck && bun run build && bun run test",
    "test:web": "turbo run test --filter=@consubov/web",
    "test:api": "turbo run test --filter=@consubov/api"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "eslint-plugin-security": "^4.2.0",
    "turbo": "^2.5.0",
    "vitest": "^5.0.3"
  }
}
