{
  "name": "consubov",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@consubov/web",
    "dev:api": "turbo run dev --filter=@consubov/api",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@consubov/web",
    "build:api": "turbo run build --filter=@consubov/api",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "bun run typecheck && bun run build && bun run test",
    "test:web": "turbo run test --filter=@consubov/web",
    "quality:phase5:local": "bash scripts/run-phase5-local.sh",
    "quality:phase6:local": "bash scripts/run-phase6-local.sh",
    "quality:phase7:local": "bash scripts/run-phase7-local.sh",
    "quality:phase8:local": "bash scripts/run-phase8-local.sh",
    "quality:phase9:local": "bash scripts/run-phase9-local.sh",
    "quality:phase10:local": "bash scripts/run-phase10-local.sh"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "eslint-plugin-security": "^4.2.0",
    "turbo": "^2.5.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "lodash@>=4.0.0 <=4.17.23": "4.18.0",
    "flatted@<3.4.2": "3.4.2",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "@remix-run/router@<=1.23.1": "1.23.2",
    "postcss@<=8.5.22": "8.5.23",
    "form-data@>=4.0.0 <4.0.6": "4.0.6",
    "nanoid@<3.3.18": "3.3.18",
    "glob@>=10.2.0 <10.5.0": "10.5.0",
    "ws@>=8.0.0 <8.21.0": "8.21.0",
    "browserslist@<=4.28.6": "4.28.7",
    "d3-color@>=1.0.2 <3.1.0": "3.1.0",
    "minimatch@<3.1.5": "3.1.5",
    "minimatch@>=9.0.0 <9.0.7": "9.0.7",
    "brace-expansion@<1.1.20": "1.1.20",
    "brace-expansion@>=2.0.0 <2.1.6": "2.1.6",
    "picomatch@<2.3.2": "2.3.2",
    "source-map-js@<1.2.2": "1.2.2",
    "braces": "github:FSDevelop/braces#d0d575e55e74a4e0218e5248fafb79efc3e54ebb"
  }
}
